{
  "expo": {
    "name": "Capetown Luxury Chauffeur",
    "slug": "capetown-luxury-chauffeur",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capetownluxurychauffeur.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.capetownluxurychauffeur.app",
      "permissions": ["NOTIFICATIONS"]
    },
    "notification": {
      "color": "#000000",
      "androidMode": "default"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "apiBaseUrl": "https://web-production-1ab9.up.railway.app",
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
